# LLM (candidate-owned free key — never commit real keys)
LLM_PROVIDER=NVIDIA
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct

# Alternatives:
# LLM_PROVIDER=GROQ
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
#
# LLM_PROVIDER=OLLAMA
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# App
DATA_DIR=./data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PUBLIC_CHAT_ONLY=false
# On Oracle / public VMs use PUBLIC_CHAT_ONLY=true (also set by docker-compose.prod.yml).
# Use a long random string. In Docker Compose .env files, escape each `$` as `$$`
# e.g. abc$xyz must be written as abc$$xyz or Compose will eat the `$...` part.
OWNER_SECRET=
GITHUB_TOKEN=
HOST=0.0.0.0
PORT=7860

# Comma-separated list of allowed chat-page origins, or `*` for any (dev default).
# Never combine `*` with credentials in production; set this to your real domain(s).
ALLOWED_ORIGINS=*

# Retrieval: hybrid dense+BM25 fusion with cross-encoder rerank (all CPU/ONNX, no GPU).
# Disable RERANK_ENABLED if latency is too high on very small VMs.
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=30
RERANK_TOP_K=8
RELEVANCE_GATE_SCORE=-2.0
QUERY_REWRITE_ENABLED=true

# Rate limiting: in-process token bucket (per client) + per-agent daily chat cap.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=10
AGENT_DAILY_CHAT_LIMIT=300

# Structured JSON logs (set false for human-readable local dev logs)
JSON_LOGS=true
